rules_version = '2';

// ===============================================================
// Assumed data model
// ===============================================================
// users/{uid}: role, companyId, active (authorization fields only).
// Operational documents: companyId, createdAt, updatedAt, createdBy.
// expenses/{id} optionally stores employeePaymentType, competenceMonth and tripId
// only when an employee payment is classified.
// cards/{id}: recordType of card, buyer or cardSchedule.
// auditLogs/{id}: append-only audit records created in the same batch as a
// permitted operational write.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && currentUser().active == true;
    }

    function sameCompany(companyId) {
      return activeUser() && currentUser().companyId == companyId;
    }

    function hasAnyRole(roles) {
      return activeUser() && currentUser().role in roles;
    }

    function isAdmin() {
      return hasAnyRole(['admin']);
    }

    function isFinance() {
      return hasAnyRole(['finance', 'financeiro']);
    }

    function isOperator() {
      return hasAnyRole(['operator', 'operador']);
    }

    function hasOnly(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function reqStr(val, maxLength) {
      return val != '' && (val + '').size() <= maxLength;
    }

    function optStr(val, maxLength) {
      return (val + '').size() <= maxLength;
    }

    function numMax(val, maxValue) {
      return val >= 0 && val <= maxValue;
    }

    function numHalf(val, halfMax) {
      return math.abs(val - halfMax) <= halfMax;
    }

    function isIsoDateVal(val) {
      return val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function validListMax(val, maxSize) {
      return val is list && val.size() <= maxSize;
    }

    function validOtherCosts(val) {
      return numHalf(val, 500000) || validListMax(val, 30);
    }

    function requiredString(data, field, maxLength) {
      return reqStr(data[field], maxLength);
    }

    function optionalString(data, field, maxLength) {
      return optStr(data.get(field, ''), maxLength);
    }

    function isoDate(data, field) {
      return isIsoDateVal(data[field]);
    }

    function nonNegativeNumber(data, field, maxValue) {
      return data[field] is number && numMax(data[field], maxValue);
    }

    function validMetadata(data) {
      return reqStr(data.companyId, 80)
        && reqStr(data.createdBy, 160)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validCreateMetadata(data) {
      return validMetadata(data)
        && data.companyId == currentUser().companyId
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validUpdateMetadata(data) {
      return validMetadata(data)
        && data.companyId == resource.data.companyId
        && data.createdBy == resource.data.createdBy
        && data.createdAt == resource.data.createdAt
        && data.updatedAt == request.time;
    }

    function validVehicle(data) {
      return hasOnly(data, [
        'companyId', 'createdAt', 'updatedAt', 'createdBy',
        'modelo', 'ano', 'cor', 'placa', 'kmAtual', 'lugares', 'status',
        'nome', 'tipo', 'capacidade', 'layout', 'consumoKmPorLitro', 'custoManutencaoKm',
        'tankCapacityL', 'fuelLevelL', 'statusOperacional',
        'proximaRevisaoKm', 'proximaRevisaoTexto', 'motoristaPadrao',
        'motoristaId', 'ultimaRota', 'revisaoPendente'
      ])
        && requiredString(data, 'modelo', 120)
        && data.ano is number && data.ano >= 1900 && data.ano <= 2100
        && requiredString(data, 'cor', 60)
        && optionalString(data, 'placa', 16)
        && nonNegativeNumber(data, 'kmAtual', 5000000)
        && data.lugares is number && data.lugares >= 1 && data.lugares <= 100
        && data.status in ['ativo', 'inativo']
        && optionalString(data, 'nome', 120)
        && (!('tipo' in data) || data.tipo in ['onibus', 'microonibus', 'van'])
        && (!('capacidade' in data) || (data.capacidade is number && data.capacidade >= 1 && data.capacidade <= 100))
        && optionalString(data, 'layout', 60)
        && (!('consumoKmPorLitro' in data) || nonNegativeNumber(data, 'consumoKmPorLitro', 100))
        && (!('custoManutencaoKm' in data) || nonNegativeNumber(data, 'custoManutencaoKm', 1000))
        && (!('tankCapacityL' in data) || nonNegativeNumber(data, 'tankCapacityL', 5000))
        && (!('fuelLevelL' in data) || nonNegativeNumber(data, 'fuelLevelL', 5000))
        && (!('statusOperacional' in data) || data.statusOperacional in ['disponivel', 'em_viagem', 'manutencao'])
        && (!('proximaRevisaoKm' in data) || nonNegativeNumber(data, 'proximaRevisaoKm', 5000000))
        && optionalString(data, 'proximaRevisaoTexto', 120)
        && optionalString(data, 'motoristaPadrao', 140)
        && optionalString(data, 'motoristaId', 160)
        && optionalString(data, 'ultimaRota', 220)
        && (!('revisaoPendente' in data) || data.revisaoPendente is bool);
    }

    function validEmployee(data) {
      return hasOnly(data, [
        'companyId', 'createdAt', 'updatedAt', 'createdBy',
        'nome', 'cargo', 'telefone', 'salarioBase', 'status'
      ])
        && requiredString(data, 'nome', 140)
        && requiredString(data, 'cargo', 100)
        && requiredString(data, 'telefone', 30)
        && nonNegativeNumber(data, 'salarioBase', 1000000)
        && data.status in ['ativo', 'inativo'];
    }

    function validPaymentDetails(data) {
      return data.paymentDetails is map && data.paymentDetails.size() <= 8;
    }

    function validOptionalInstallments(data) {
      return !('installments' in data)
        || (data.installments is number && data.installments >= 1 && data.installments <= 120);
    }

    function validExpenseRelations(data) {
      return data.keys().hasAll(['veiculoId', 'vehicleId', 'funcionarioId', 'employeeId'])
        && optionalString(data, 'veiculoId', 160)
        && optionalString(data, 'vehicleId', 160)
        && optionalString(data, 'funcionarioId', 160)
        && optionalString(data, 'employeeId', 160)
        && data.veiculoId == data.vehicleId
        && data.funcionarioId == data.employeeId;
    }

    function validEmployeePaymentCategory(data) {
      return (
        data.categoria == 'salarios_adiantamentos'
        && data.employeePaymentType in ['advance', 'salary']
      ) || (
        data.categoria == 'viagens_extras'
        && data.employeePaymentType in ['daily', 'other']
      );
    }

    function validEmployeePayment(data) {
      return (
        !('employeePaymentType' in data)
        && !('competenceMonth' in data)
        && !('tripId' in data)
      ) || (
        data.keys().hasAll(['employeePaymentType', 'competenceMonth'])
        && requiredString(data, 'employeeId', 160)
        && data.funcionarioId == data.employeeId
        && exists(/databases/$(database)/documents/employees/$(data.employeeId))
        && get(/databases/$(database)/documents/employees/$(data.employeeId)).data.companyId == currentUser().companyId
        && validEmployeePaymentCategory(data)
        && data.competenceMonth is string
        && data.competenceMonth.matches('^\\d{4}-(0[1-9]|1[0-2])$')
        && optionalString(data, 'tripId', 160)
        && (!('tripId' in data) || (
          data.categoria == 'viagens_extras'
          && exists(/databases/$(database)/documents/trips/$(data.tripId))
          && get(/databases/$(database)/documents/trips/$(data.tripId)).data.companyId == currentUser().companyId
        ))
      );
    }

    function validExpense(data) {
      return hasOnly(data, [
        'companyId', 'createdAt', 'updatedAt', 'createdBy',
        'data', 'categoria', 'descricao', 'descricaoGasto', 'valor',
        'veiculoId', 'vehicleId', 'funcionarioId', 'employeeId',
        'paymentMethod', 'status', 'comprovanteUrl', 'paymentDetails',
        'cardId', 'buyerId', 'installments', 'employeePaymentType',
        'competenceMonth', 'tripId'
      ])
        && isoDate(data, 'data')
        && requiredString(data, 'categoria', 80)
        && requiredString(data, 'descricao', 800)
        && optionalString(data, 'descricaoGasto', 800)
        && nonNegativeNumber(data, 'valor', 10000000)
        && validExpenseRelations(data)
        && data.paymentMethod in ['pix', 'dinheiro', 'cheque', 'cartao_credito']
        && data.status in ['pago', 'a_pagar']
        && optionalString(data, 'comprovanteUrl', 500)
        && validPaymentDetails(data)
        && optionalString(data, 'cardId', 160)
        && optionalString(data, 'buyerId', 160)
        && validOptionalInstallments(data)
        && validEmployeePayment(data);
    }

    function validFueling(data) {
      return hasOnly(data, [
        'companyId', 'createdAt', 'updatedAt', 'createdBy',
        'data', 'fuelingDate', 'veiculoId', 'vehicleId', 'ultimoKm', 'kmAtual', 'litros',
        'valorTotal', 'distanciaPercorrida', 'mediaKmLitro', 'precoLitro',
        'paymentMethod', 'status', 'paymentDetails', 'cardId', 'buyerId', 'installments'
      ])
        && isoDate(data, 'data')
        && (!('fuelingDate' in data) || (isoDate(data, 'fuelingDate') && data.fuelingDate == data.data))
        && requiredString(data, 'veiculoId', 160)
        && data.vehicleId == data.veiculoId
        && nonNegativeNumber(data, 'ultimoKm', 5000000)
        && nonNegativeNumber(data, 'kmAtual', 5000000) && data.kmAtual > data.ultimoKm
        && nonNegativeNumber(data, 'litros', 10000) && data.litros > 0
        && nonNegativeNumber(data, 'valorTotal', 10000000)
        && nonNegativeNumber(data, 'distanciaPercorrida', 5000000)
        && nonNegativeNumber(data, 'mediaKmLitro', 1000)
        && nonNegativeNumber(data, 'precoLitro', 10000)
        && data.paymentMethod in ['pix', 'dinheiro', 'cheque', 'cartao_credito']
        && data.status in ['pago', 'a_pagar']
        && validPaymentDetails(data)
        && optionalString(data, 'cardId', 160)
        && optionalString(data, 'buyerId', 160)
        && validOptionalInstallments(data);
    }

    function validTrip(data) {
      let d = data;
      return hasOnly(d, [
        'companyId', 'createdAt', 'updatedAt', 'createdBy',
        'responsible', 'client', 'origin', 'destination', 'stops', 'itinerary',
        'vehicleIds', 'vehicleId', 'employeeId', 'departureDate', 'returnDate',
        'durationDays', 'vehiclesQty', 'oneWayKm', 'totalKm', 'pricePerKm',
        'baseValue', 'discount', 'finalValue', 'status', 'emissionDate', 'emissaoDate',
        'orcamentoNum', 'validadeDias', 'passengers', 'consumptionKmPerLiter', 'emptyKm',
        'fuelPrice', 'driver1Type', 'driver1Value', 'driver2Type', 'driver2Value',
        'lodgingCost', 'anttCost', 'waterCost', 'insuranceCost', 'otherCosts',
        'clientPhone', 'clientEmail', 'boardingPlace', 'departureTime', 'returnTime',
        'localDisplacementKm', 'totalOperationalKm', 'totalCapacity',
        'driver1Days', 'driver2Days', 'tollsCost', 'parkingCost', 'driverMealsCost',
        'manualBaseValue', 'manualFinalValue', 'costsConfirmedZero', 'vehicleConfigs',
        'paymentTerms', 'included', 'notIncluded', 'rules', 'cancellationPolicy', 'amenities',
        'depositSignalValue', 'depositPaidValue', 'balanceDueDate', 'paymentInstallmentNotes'
      ])
        && reqStr(d.responsible, 140)
        && reqStr(d.client, 140)
        && reqStr(d.origin, 220)
        && reqStr(d.destination, 220)
        && reqStr(d.status, 40)
        && validListMax(d.stops, 10)
        && d.itinerary is list && math.abs(d.itinerary.size() - 7) <= 5
        && validListMax(d.vehicleIds, 20)
        && isIsoDateVal(d.departureDate) && isIsoDateVal(d.returnDate)
        && d.returnDate >= d.departureDate
        && math.abs(d.durationDays - 183) <= 182
        && math.abs(d.vehiclesQty - 10.5) <= 9.5
        && numHalf(d.oneWayKm, 50000)
        && numHalf(d.totalKm, 100000)
        && numHalf(d.pricePerKm, 5000)
        && numHalf(d.baseValue, 5000000)
        && numHalf(d.discount, 5000000)
        && numHalf(d.finalValue, 5000000)
        && (
          d.status in ['Rascunho', 'Cancelada', 'Recusado', 'Expirado']
          || (d.totalKm > 0 && d.baseValue > 0 && d.finalValue > 0)
        )
        && (isIsoDateVal(d.get('emissionDate', '')) || isIsoDateVal(d.get('emissaoDate', '')))
        && numHalf(d.get('validadeDias', 0), 182.5)
        && numHalf(d.get('passengers', 0), 500)
        && numHalf(d.get('consumptionKmPerLiter', 0), 50)
        && numHalf(d.get('emptyKm', 0), 100000)
        && numHalf(d.get('fuelPrice', 0), 500)
        && numHalf(d.get('driver1Value', 0), 500000)
        && numHalf(d.get('driver2Value', 0), 500000)
        && numHalf(d.get('lodgingCost', 0), 500000)
        && numHalf(d.get('anttCost', 0), 500000)
        && numHalf(d.get('waterCost', 0), 500000)
        && numHalf(d.get('insuranceCost', 0), 500000)
        && validOtherCosts(d.get('otherCosts', 0))
        && numHalf(d.get('localDisplacementKm', 0), 100000)
        && numHalf(d.get('totalOperationalKm', 0), 250000)
        && numHalf(d.get('totalCapacity', 0), 500)
        && numHalf(d.get('driver1Days', 0), 182.5)
        && numHalf(d.get('driver2Days', 0), 182.5)
        && numHalf(d.get('tollsCost', 0), 500000)
        && numHalf(d.get('parkingCost', 0), 500000)
        && numHalf(d.get('driverMealsCost', 0), 500000)
        && numHalf(d.get('manualBaseValue', 0), 5000000)
        && numHalf(d.get('manualFinalValue', 0), 5000000)
        && d.get('costsConfirmedZero', false) is bool
        && validListMax(d.get('vehicleConfigs', []), 20)
        && validListMax(d.get('amenities', []), 30)
        && numHalf(d.get('depositSignalValue', 0), 5000000)
        && numHalf(d.get('depositPaidValue', 0), 5000000)
        && optStr(
          d.get('vehicleId', '')
          + d.get('employeeId', '')
          + d.get('orcamentoNum', '')
          + d.get('driver1Type', '')
          + d.get('driver2Type', '')
          + d.get('clientPhone', '')
          + d.get('clientEmail', '')
          + d.get('boardingPlace', '')
          + d.get('departureTime', '')
          + d.get('returnTime', '')
          + d.get('balanceDueDate', ''),
          1000
        )
        && optStr(
          d.get('paymentTerms', '')
          + d.get('included', '')
          + d.get('notIncluded', '')
          + d.get('rules', '')
          + d.get('cancellationPolicy', '')
          + d.get('paymentInstallmentNotes', ''),
          8500
        );
    }

    function validCard(data) {
      return hasOnly(data, [
        'companyId', 'createdAt', 'updatedAt', 'createdBy',
        'recordType', 'nome', 'fechamento', 'vencimento'
      ])
        && data.recordType == 'card'
        && requiredString(data, 'nome', 100)
        && data.fechamento is number && data.fechamento >= 1 && data.fechamento <= 31
        && data.vencimento is number && data.vencimento >= 1 && data.vencimento <= 31;
    }

    function validBuyer(data) {
      return hasOnly(data, [
        'companyId', 'createdAt', 'updatedAt', 'createdBy',
        'recordType', 'nome', 'status'
      ])
        && data.recordType == 'buyer'
        && requiredString(data, 'nome', 140)
        && data.status in ['ativo', 'inativo'];
    }

    function validCardSchedule(data) {
      return hasOnly(data, [
        'companyId', 'createdAt', 'updatedAt', 'createdBy', 'recordType',
        'sourceType', 'sourceId', 'description', 'cardId', 'buyerId', 'parcela',
        'totalParcelas', 'valor', 'vencimento', 'status', 'veiculoId', 'vehicleId',
        'funcionarioId', 'employeeId', 'category'
      ])
        && data.recordType == 'cardSchedule'
        && data.sourceType in ['expense', 'fuel']
        && requiredString(data, 'sourceId', 160)
        && requiredString(data, 'description', 900)
        && requiredString(data, 'cardId', 160)
        && requiredString(data, 'buyerId', 160)
        && data.parcela is number && data.parcela >= 1 && data.parcela <= 120
        && data.totalParcelas is number && data.totalParcelas >= data.parcela && data.totalParcelas <= 120
        && nonNegativeNumber(data, 'valor', 10000000)
        && isoDate(data, 'vencimento')
        && data.status in ['pago', 'a_pagar', 'futuro']
        && validExpenseRelations(data)
        && optionalString(data, 'category', 80);
    }

    function validCardsRecord(data) {
      return validCard(data) || validBuyer(data) || validCardSchedule(data);
    }

    function canCreate(data) {
      return activeUser() && validCreateMetadata(data);
    }

    function canUpdate(data) {
      return sameCompany(resource.data.companyId) && validUpdateMetadata(data);
    }

    function hasRoleInCompany(roles, companyId) {
      let u = currentUser();
      return signedIn() && u.active == true && u.companyId == companyId && u.role in roles;
    }

    function isValidUser(data) {
      return hasOnly(data, ['role', 'companyId', 'active'])
        && requiredString(data, 'companyId', 80)
        && data.role in ['admin', 'finance', 'financeiro', 'operator', 'operador']
        && data.active is bool;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if isAdmin() && resource.data.companyId == currentUser().companyId;
      allow create: if isAdmin()
        && request.resource.data.companyId == currentUser().companyId
        && isValidUser(request.resource.data);
      allow update: if isAdmin()
        && resource.data.companyId == currentUser().companyId
        && request.resource.data.companyId == resource.data.companyId
        && isValidUser(request.resource.data);
      allow delete: if isAdmin() && resource.data.companyId == currentUser().companyId;
    }

    match /vehicles/{vehicleId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if (isAdmin() || isOperator()) && canCreate(request.resource.data) && validVehicle(request.resource.data);
      allow update: if (isAdmin() || isOperator()) && canUpdate(request.resource.data) && validVehicle(request.resource.data);
      allow delete: if isAdmin() && sameCompany(resource.data.companyId);
    }

    match /expenses/{expenseId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if (isAdmin() || isFinance()) && canCreate(request.resource.data) && validExpense(request.resource.data);
      allow update: if (isAdmin() || isFinance()) && canUpdate(request.resource.data) && validExpense(request.resource.data);
      allow delete: if (isAdmin() || isFinance()) && sameCompany(resource.data.companyId);
    }

    match /trips/{tripId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if hasRoleInCompany(['admin', 'operator', 'operador', 'finance', 'financeiro'], request.resource.data.companyId)
        && validMetadata(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validTrip(request.resource.data);
      allow update: if hasRoleInCompany(['admin', 'operator', 'operador', 'finance', 'financeiro'], resource.data.companyId)
        && validUpdateMetadata(request.resource.data)
        && validTrip(request.resource.data);
      allow delete: if hasRoleInCompany(['admin', 'operator', 'operador', 'finance', 'financeiro'], resource.data.companyId);
    }

    match /fuelings/{fuelingId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if (isAdmin() || isOperator()) && canCreate(request.resource.data) && validFueling(request.resource.data);
      allow update: if (isAdmin() || isOperator()) && canUpdate(request.resource.data) && validFueling(request.resource.data);
      allow delete: if (isAdmin() || isOperator()) && sameCompany(resource.data.companyId);
    }

    match /employees/{employeeId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if isAdmin() && canCreate(request.resource.data) && validEmployee(request.resource.data);
      allow update: if isAdmin() && canUpdate(request.resource.data) && validEmployee(request.resource.data);
      allow delete: if isAdmin() && sameCompany(resource.data.companyId);
    }

    match /orcamentos/{orcamentoId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if (isAdmin() || isFinance() || isOperator()) && canCreate(request.resource.data);
      allow update: if (isAdmin() || isFinance() || isOperator()) && canUpdate(request.resource.data);
      allow delete: if (isAdmin() || isFinance()) && sameCompany(resource.data.companyId);
    }

    match /cards/{cardId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if canCreate(request.resource.data)
        && (
          (isAdmin() && validCardsRecord(request.resource.data))
          || (isFinance() && validCardSchedule(request.resource.data) && request.resource.data.sourceType == 'expense')
          || (isOperator() && validCardSchedule(request.resource.data) && request.resource.data.sourceType == 'fuel')
        );
      allow update: if canUpdate(request.resource.data)
        && (
          (isAdmin() && resource.data.recordType == request.resource.data.recordType && validCardsRecord(request.resource.data))
          || (
            resource.data.recordType == 'cardSchedule'
            && validCardSchedule(request.resource.data)
            && resource.data.sourceType == request.resource.data.sourceType
            && (
              isFinance()
              || (isOperator() && resource.data.sourceType == 'fuel' && request.resource.data.sourceType == 'fuel')
            )
          )
        );
      allow delete: if sameCompany(resource.data.companyId)
        && (
          isAdmin()
          || (
            resource.data.recordType == 'cardSchedule'
            && (isFinance() || (isOperator() && resource.data.sourceType == 'fuel'))
          )
        );
    }

    match /auditLogs/{logId} {
      allow get, list: if isAdmin() && sameCompany(resource.data.companyId);
      allow create: if activeUser()
        && hasOnly(request.resource.data, [
          'action', 'collection', 'documentId', 'companyId', 'createdBy', 'createdAt'
        ])
        && request.resource.data.action in ['create', 'update', 'delete']
        && requiredString(request.resource.data, 'collection', 40)
        && requiredString(request.resource.data, 'documentId', 160)
        && request.resource.data.companyId == currentUser().companyId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
    }
  }
}
